      "default": "./dist/note.js"
    },
    "./storage": {
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./store": {
      "import": "./dist/store.mjs",
      "require": "./dist/store.js",
      "default": "./dist/store.js"
    },
    "./dist/config": {
      "import": "./dist/config.mjs",
      "require": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./dist/conf": {
      "import": "./dist/conf.mjs",
      "require": "./dist/conf.js",
      "default": "./dist/conf.js"
    },
    "./dist/note": {
      "import": "./dist/note.mjs",
      "require": "./dist/note.js",
      "default": "./dist/note.js"
    },
    "./dist/storage": {
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.js",
      "default": "./dist/storage.js"
    },
    "./dist/store": {
      "import": "./dist/store.mjs",
      "require": "./dist/store.js",
      "default": "./dist/store.js"
    },
    "./dist/utils": {
      "import": "./dist/utils.mjs",
      "require": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*.mjs": "./dist/*.mjs",
    "./dist/*.map": "./dist/*.map",
    "./dist/*.ejs": "./dist/*.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && rollup -c",
